+
+/* Keep only the headers RFC 1867 processing actually uses. Requests carrying
+ * many unrelated or duplicated headers are the cheap way to blow up the
+ * per-header allocation, so drop everything else. */
+static zend_bool php_mime_should_save_hdr(const char *name)
+{
+	return !strcasecmp(name, "Content-Disposition")
+		|| !strcasecmp(name, "Content-Type");
+}
