+static void zend_mm_safe_error_ex(const char *format, ...)
+{
+	va_list args;
+	const char *error_filename = NULL;
+	uint lineno = 0;
+
+	if (zend_is_compiling()) {
+		error_filename = zend_get_compiled_filename();
+		lineno = zend_get_compiled_lineno();
+	} else if (EG(current_execute_data) && EG(current_execute_data)->func) {
+		error_filename = EG(current_execute_data)->func->op_array.filename;
+		if (EG(current_execute_data)->opline) {
+			lineno = EG(current_execute_data)->opline->lineno;
+		}
+	}
+	if (!error_filename) {
+		error_filename = "Unknown";
+	}
+
+	fprintf(stderr, "\nFatal error: ");
+	va_start(args, format);
+	vfprintf(stderr, format, args);
+	va_end(args);
+	fprintf(stderr, " in %s on line %u\n", error_filename, (unsigned) lineno);
+	fflush(stderr);
+	_exit(1);
+}
+
